---
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';
export const prerender = true;
export async function getStaticPaths() { const articles = await getCollection('articles', ({ data }) => data.status === 'published'); return articles.map(a=>({params:{slug:a.id},props:{article:a}})); }
const { article } = Astro.props;
const { Content } = await render(article);
const minutes = Math.max(1, Math.ceil(article.body.split(/\s+/).length / 220));
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{article.data.title} | 2step</title><meta name="description" content={article.data.description}/><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/></head><body class="bg-[#f8f7fd] text-[#101022]"><main class="mx-auto max-w-3xl px-5 py-14"><a href="/articles" class="text-sm font-bold text-[#5422bb]">← All articles</a><p class="mt-10 text-sm font-bold uppercase tracking-[.18em] text-[#6a45c4]">{article.data.category} · {minutes} min read</p><h1 class="mt-3 text-5xl font-black tracking-[-.06em]">{article.data.title}</h1><p class="mt-5 text-xl leading-relaxed text-[#504e61]">{article.data.description}</p><div class="prose prose-lg mt-10 max-w-none prose-headings:font-black prose-headings:tracking-tight"><Content /></div><div class="mt-12 rounded-3xl bg-[#eee7ff] p-7"><p class="font-bold text-[#5422bb]">Continue the conversation</p><h2 class="mt-2 text-2xl font-black">Ask AI about this article</h2><p class="mt-2 text-[#504e61]">Open the Question Pad with this article as the starting context.</p><a href={`/?article=${encodeURIComponent(article.data.title)}#ask`} class="mt-5 inline-flex rounded-full bg-[#5422bb] px-5 py-3 font-bold text-white">Ask about this article →</a></div></main></body></html>
