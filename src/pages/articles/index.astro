---
import '../../styles/global.css';
import { getCollection } from 'astro:content';
const articles = (await getCollection('articles', ({ data }) => data.status === 'published')).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Articles | Mavuka People Advisory</title><meta name="description" content="Mavuka People Advisory insights and resources."/></head><body class="bg-[#f8f7fd] text-[#101022]"><main class="mx-auto max-w-5xl px-5 py-14"><a href="/" class="inline-flex items-center gap-2 text-sm font-bold text-[#5422bb]">← Back to Question Pad</a><p class="mt-10 text-sm font-bold uppercase tracking-[.18em] text-[#6a45c4]">Mavuka insights</p><h1 class="mt-3 max-w-2xl text-5xl font-black tracking-[-.06em]">Practical perspectives for organisations in change.</h1><p class="mt-4 max-w-xl text-lg text-[#504e61]">Resources from Mavuka People Advisory.</p>{articles.length ? <div class="mt-10 grid gap-5 md:grid-cols-3">{articles.map(article => <article class="rounded-3xl border border-[#e6e1ed] bg-white p-6 shadow-sm"><p class="text-xs font-bold uppercase tracking-wider text-[#6a45c4]">{article.data.category} · {article.data.publishedAt.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</p><h2 class="mt-4 text-xl font-extrabold leading-tight"><a href={`/articles/${article.id}`}>{article.data.title}</a></h2><p class="mt-3 text-sm leading-relaxed text-[#565368]">{article.data.description}</p><a class="mt-6 inline-block text-sm font-bold text-[#5422bb]" href={`/articles/${article.id}`}>Read article →</a></article>)}</div> : <p class="mt-10 rounded-3xl bg-white p-7 text-[#504e61] shadow-sm">New articles are currently being prepared.</p>}</main></body></html>
